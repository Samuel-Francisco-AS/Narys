{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Assistente 3D",
  "version": "0.1.0",
  "identifier": "br.com.assistente3d.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Narys",
        "width": 1120,
        "height": 720,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "fullscreen": false,
        "minWidth": 640,
        "minHeight": 480,
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:5173 ws://localhost:5173",
        "worker-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": [
        "main-window",
        "settings-general",
        "settings-ai"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
