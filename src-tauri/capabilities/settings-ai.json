{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-ai",
  "description": "Janela IA independente: policy cognitiva, credenciais Gemini/Groq e diagnóstico Groq.",
  "windows": [
    "settings-ai"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "allow-get-ai-settings",
    "allow-update-cognitive-role-policy",
    "allow-update-gemini-timeouts",
    "allow-gemini-set-api-key",
    "allow-gemini-delete-api-key",
    "allow-groq-status",
    "allow-groq-set-api-key",
    "allow-groq-delete-api-key",
    "allow-groq-probe"
  ]
}
