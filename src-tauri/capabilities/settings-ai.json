{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-ai",
  "description": "Janela IA independente: policy cognitiva, credenciais dos Cognitive Providers e diagnósticos.",
  "windows": [
    "settings-ai"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "allow-get-ai-settings",
    "allow-get-provider-operational-snapshot",
    "allow-update-cognitive-role-policy",
    "allow-update-cognitive-role-settings",
    "allow-start-orchestrator-planning",
    "allow-start-task-graph",
    "allow-cancel-task",
    "allow-update-provider-timeouts",
    "allow-update-provider-rate-policy",
    "allow-get-codex-runtime-status",
    "allow-probe-codex-app-server",
    "allow-probe-codex-planner",
    "allow-probe-codex-planner-preflight",
    "allow-gemini-set-api-key",
    "allow-gemini-delete-api-key",
    "allow-groq-status",
    "allow-groq-set-api-key",
    "allow-groq-delete-api-key",
    "allow-groq-probe",
    "allow-mistral-status",
    "allow-mistral-set-api-key",
    "allow-mistral-delete-api-key",
    "allow-cloudflare-status",
    "allow-cloudflare-set-credentials",
    "allow-cloudflare-delete-credentials"
  ]
}
