{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Janela main: conversa, Economy Shell, snapshot operacional read-only e controles de janela; sem filesystem, shell ou Stronghold no WebView.",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:window:allow-is-always-on-top",
    "core:window:allow-outer-position",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-start-mock-task",
    "allow-cancel-task",
    "allow-security-status",
    "allow-security-test-store-secret",
    "allow-security-test-delete-secret",
    "allow-lr4-status",
    "allow-lr4-import-private-bootstrap",
    "allow-lr4-create-diagnostic-conversation",
    "allow-lr4-get-recent-conversation",
    "allow-start-mock-cognition-task",
    "allow-cognition-provider-status",
    "allow-open-general-settings-window",
    "allow-get-general-settings",
    "allow-gemini-status",
    "allow-gemini-conversation",
    "allow-create-conversation-session",
    "allow-get-conversation-session",
    "allow-close-conversation-session",
    "allow-resume-conversation-session",
    "allow-list-conversation-history",
    "allow-get-conversation-history-session",
    "allow-conversation-routing-status",
    "allow-start-conversation-task",
    "allow-get-shell-settings",
    "allow-update-presentation-mode",
    "allow-update-shell-layout",
    "allow-open-ai-settings-window",
    "allow-get-provider-operational-snapshot",
    "core:window:allow-set-min-size",
    "core:window:allow-set-resizable",
    "core:window:allow-set-background-color",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
